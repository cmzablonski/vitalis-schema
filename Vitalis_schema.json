y serving Medford, Boston, Cambridge, Somerville, Arlington, Brookline, and the greater Boston area.","additionalType":["https://www.wikidata.org/wiki/Q875588","https://www.wikidata.org/wiki/Q131734","https://www.wikidata.org/wiki/Q2360219","https://www.wikidata.org/wiki/Q4671277","https://www.wikidata.org/wiki/Q1076486","https://www.wikidata.org/wiki/Q15328733","https://www.wikidata.org/wiki/Q3423599","https://www.wikidata.org/wiki/Q178659","https://www.wikidata.org/wiki/Q484370","https://www.wikidata.org/wiki/Q12135"],"keywords":"facial spa, beauty salon, day spa, esthetics service, health spa, massage spa, medical spa, skin care clinic, spa, acne facial, acne treatments, anti-aging facial, basic facial, chemical peels, deep cleansing facial, dermaplaning, facial lymphatic drainage, facial massage, glycolic peels, hydradermabrasion, HydraFacial, lactic acid peels, LED skin phototherapy treatments, mesotherapy, microdermabrasion, microneedling, pigmentation problem treatments, rosacea facial, salicylic peels, enzymatic peel, peels, skin analysis, 3D skin analysis, dermabrasion, RF, radiofrequency, radio frequency skin tightening, pore extraction, nanoneedling, melasma treatment, melasma, anti-aging treatments, anti-aging, facial, skin treatments, spa packages, advanced facials, RF skin tightening, Medford MA spa, Boston MA facial spa","priceRange":"$80 - $230","address":{"@type":"PostalAddress","streetAddress":"151 Mystic Ave","addressLocality":"Medford","addressRegion":"MA","postalCode":"02155","addressCountry":"US"},"geo":{"@type":"GeoCoordinates","latitude":42.4095145,"longitude":-71.1058599},"hasMap":"https://maps.app.goo.gl/xAGeAQKTH4oznJgj9","telephone":"+1-617-500-5515","paymentAccepted":["Cash","Check","Visa","MasterCard","American Express","Discover","Debit Card","Apple Pay","Google Pay","Samsung Pay","Gift Card","Buy Now, Pay Later"],"currenciesAccepted":"USD","openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday